# Exact environment-variable recipe used for every result reported in the
# paper ("strong recipe"). The module defaults are weaker legacy values kept
# for backward compatibility; set these before running any stage.
UA_CAPTION_CAP=100        # captions per (client, class)
UA_SYN_PER_PROTO=30       # feature-skew family (label-skew setting uses 180)
UA_TEACHER_EPOCHS=40
UA_TEACHER_LR=3e-4
UA_TEACHER_WD=1e-4
UA_TEACHER_COS=1          # cosine LR schedule
UA_DISTILL_EPOCHS=60
UA_DISTILL_COS=1
# UA_TEACHER_SEED=<n>     # optional: teacher-realization resampling
#                         # (torch.manual_seed(n*100 + client) before training)
# Determinism caveat: synthetic images are generated with per-batch seeds at
# batch size 5 (server/generation.py); reproducing D_syn bit-exactly requires
# the same batch size, diffusers version, and GPU architecture.
